{
  "openapi": "3.1.0",
  "info": {
    "title": "OPENSHELF API",
    "version": "0.2.0",
    "description": "Browser integration contracts for private-document search, safe x402 recovery, verified payout wallets, and paid-buyer feedback."
  },
  "servers": [{ "url": "http://127.0.0.1:8787" }],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Process liveness",
        "responses": { "200": { "description": "Live" } }
      }
    },
    "/readyz": {
      "get": {
        "summary": "SQLite readiness",
        "responses": {
          "200": { "description": "Ready" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/questions/resolve": {
      "post": {
        "summary": "Resolve a question against private MD metadata",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResolveQuestionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A HIT quote or MISS open-call draft",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resolution" }
              }
            }
          },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/questions/{queryId}/ai-baseline": {
      "post": {
        "summary": "Generate or reuse a zero-price general baseline only while human coverage is thin",
        "parameters": [
          { "$ref": "#/components/parameters/QueryId" },
          { "$ref": "#/components/parameters/QueryToken" }
        ],
        "responses": {
          "200": {
            "description": "Generated, cached, or explicitly unavailable AI liquidity",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AiBaselineResult" }
              }
            }
          },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/shelf-starters": {
      "get": {
        "summary": "List active AI interview prompts for the authenticated contributor",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Prompts only; no buyer or reward is implied",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ShelfStarter" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Explicitly ask Gemini to create three contributor interview prompts",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Generated, cached, or unavailable prompts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "starters"],
                  "properties": {
                    "status": { "type": "string", "enum": ["generated", "cached", "unavailable"] },
                    "starters": { "type": "array", "items": { "$ref": "#/components/schemas/ShelfStarter" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/shelf-starters/{starterId}/answer": {
      "post": {
        "summary": "Publish a quality-checked human answer as a priced document",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/StarterId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["answer", "priceKrw"],
                "properties": {
                  "answer": { "type": "string", "maxLength": 10000 },
                  "priceKrw": { "type": "integer", "minimum": 5, "maximum": 10000 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Human memory and document created; earned amount starts at zero" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/questions/{queryId}/payment-progress": {
      "get": {
        "summary": "Reconcile settled, quoted, and unpaid documents before retry",
        "parameters": [
          { "$ref": "#/components/parameters/QueryId" },
          { "$ref": "#/components/parameters/Payer" },
          { "$ref": "#/components/parameters/QueryToken" }
        ],
        "responses": {
          "200": {
            "description": "Per-document payment state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentProgress" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/questions/{queryId}/paid-documents/{handle}": {
      "get": {
        "summary": "Recover a passage already settled by this payer",
        "parameters": [
          { "$ref": "#/components/parameters/QueryId" },
          { "$ref": "#/components/parameters/Handle" },
          { "$ref": "#/components/parameters/Payer" },
          { "$ref": "#/components/parameters/QueryToken" }
        ],
        "responses": {
          "200": {
            "description": "Paid passage and immutable chain receipt",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecoveredPaidDocument" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/questions/{queryId}/paid-documents/{handle}/feedback": {
      "post": {
        "summary": "Submit feedback for a passage paid by this payer",
        "parameters": [
          { "$ref": "#/components/parameters/QueryId" },
          { "$ref": "#/components/parameters/Handle" },
          { "$ref": "#/components/parameters/Payer" },
          { "$ref": "#/components/parameters/QueryToken" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubmitFeedback" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Idempotently recorded feedback",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DocumentFeedback" }
              }
            }
          },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/profile/wallet/challenge": {
      "post": {
        "summary": "Create a single-use payout-wallet ownership challenge",
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["wallet"],
                "properties": { "wallet": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message to sign with the requested Solana wallet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletChallenge" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/profile/wallet/verify": {
      "post": {
        "summary": "Verify a base58 Ed25519 signMessage signature",
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["challengeId", "signature"],
                "properties": {
                  "challengeId": { "type": "string" },
                  "signature": { "type": "string", "description": "Base58-encoded 64-byte Ed25519 signature" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile with walletVerified=true" },
          "401": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/admin/document-feedback": {
      "get": {
        "summary": "List buyer feedback and pending reports",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Pending reports first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DocumentFeedback" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/admin/document-feedback/{feedbackId}/review": {
      "post": {
        "summary": "Uphold or dismiss a pending buyer report",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "feedbackId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["decision", "note"],
                "properties": {
                  "decision": { "type": "string", "enum": ["upheld", "dismissed"] },
                  "note": { "type": "string", "minLength": 5, "maxLength": 1000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reviewed report",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DocumentFeedback" }
              }
            }
          }
        }
      }
    },
    "/api/v1/answers/synthesize": {
      "post": {
        "summary": "Synthesize only server-canonical passages already opened for a query",
        "parameters": [{ "$ref": "#/components/parameters/QueryToken" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SynthesizePaidAnswerRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cited Gemini/Vertex synthesis or an explicit evidence-only fallback",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EvidenceSynthesis" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/memory/{memoryId}": {
      "patch": {
        "summary": "Lock or unlock one owned memory and its searchable document",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MemoryId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["locked"],
                "properties": { "locked": { "type": "boolean" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Updated memory" } }
      }
    },
    "/api/v1/memory/{memoryId}/corrections": {
      "post": {
        "summary": "Create a new immutable version and lock the superseded passage",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/MemoryId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["answer"],
                "properties": { "answer": { "type": "string", "maxLength": 10000 } }
              }
            }
          }
        },
        "responses": { "201": { "description": "New correction memory version" } }
      }
    },
    "/api/v1/account/export": {
      "get": {
        "summary": "Export the authenticated contributor's profile, memories, and access log",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Portable account JSON" } }
      }
    },
    "/api/v1/contributors/{handle}": {
      "get": {
        "summary": "Public contributor manifest with hashes and versioned memory links",
        "parameters": [{ "$ref": "#/components/parameters/Handle" }],
        "responses": { "200": { "description": "Contributor manifest without private content" } }
      }
    },
    "/api/v1/personas/{handle}": {
      "get": {
        "summary": "Compatibility alias for the public contributor manifest",
        "parameters": [{ "$ref": "#/components/parameters/Handle" }],
        "responses": { "200": { "description": "Contributor manifest without private content" } }
      }
    },
    "/api/v1/documents/{handle}": {
      "get": {
        "summary": "Public paid-document metadata without the protected passage",
        "parameters": [{ "$ref": "#/components/parameters/Handle" }],
        "responses": { "200": { "description": "Hash, version, price, and x402 template" } }
      }
    },
    "/api/flash-research": {
      "get": {
        "summary": "Sandbox-only idempotent document opening",
        "parameters": [
          { "$ref": "#/components/parameters/Payer" },
          {
            "name": "queryId",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "docs",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "Sandbox passages and ledger receipt" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "openshelf_session"
      }
    },
    "parameters": {
      "QueryId": {
        "name": "queryId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "Handle": {
        "name": "handle",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "MemoryId": {
        "name": "memoryId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "StarterId": {
        "name": "starterId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "Payer": {
        "name": "payer",
        "in": "query",
        "required": true,
        "schema": { "type": "string" },
        "description": "Base58 Solana public key that settled the purchase"
      },
      "QueryToken": {
        "name": "x-openshelf-query-token",
        "in": "header",
        "required": true,
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "Error": {
        "description": "Structured API error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "ResolveQuestionRequest": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": { "type": "string", "minLength": 8, "maxLength": 1000 },
          "requestedDocuments": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
          "budgetKrw": { "type": "integer", "minimum": 0 },
          "filters": { "type": "object" }
        }
      },
      "Resolution": {
        "type": "object",
        "required": ["queryId", "paymentAccessToken", "decision", "liquidityState", "aiBaselineEligible", "matches"],
        "properties": {
          "queryId": { "type": "string" },
          "paymentAccessToken": { "type": "string", "description": "Returned once; persist locally for safe recovery" },
          "decision": { "type": "string", "enum": ["hit", "miss"] },
          "liquidityState": { "type": "string", "enum": ["ai_liquidity_only", "hybrid_coverage", "human_covered"] },
          "aiBaselineEligible": { "type": "boolean", "description": "Computed only from human supply" },
          "matches": {
            "type": "array",
            "items": { "type": "object", "description": "Payment-safe metadata; paid content is excluded" }
          }
        }
      },
      "AiBaselineResult": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["generated", "cached", "unavailable"] },
          "baseline": {
            "oneOf": [
              { "$ref": "#/components/schemas/AiBaseline" },
              { "type": "null" }
            ]
          }
        }
      },
      "AiBaseline": {
        "type": "object",
        "required": ["id", "queryId", "kind", "orientation", "generalPoints", "humanGaps", "questionsForPeople", "priceKrw", "sellable", "countsAsHumanCoverage", "expiresAt"],
        "properties": {
          "id": { "type": "string" },
          "queryId": { "type": "string" },
          "kind": { "const": "ai_baseline" },
          "orientation": { "type": "string" },
          "generalPoints": { "type": "array", "items": { "type": "string" } },
          "humanGaps": { "type": "array", "items": { "type": "string" } },
          "questionsForPeople": { "type": "array", "items": { "type": "string" } },
          "model": { "type": "string" },
          "policyVersion": { "type": "string" },
          "expiresAt": { "type": "integer" },
          "priceKrw": { "const": 0 },
          "sellable": { "const": false },
          "countsAsHumanCoverage": { "const": false }
        }
      },
      "ShelfStarter": {
        "type": "object",
        "required": ["id", "prompt", "rationale", "category", "source", "buyerWaiting", "guaranteedRewardKrw", "expiresAt"],
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string" },
          "rationale": { "type": "string" },
          "category": { "type": "string" },
          "source": { "const": "ai_interview_prompt" },
          "buyerWaiting": { "const": false },
          "guaranteedRewardKrw": { "const": 0 },
          "expiresAt": { "type": "integer" }
        }
      },
      "PaymentProgress": {
        "type": "object",
        "required": ["queryId", "payer", "documentCount", "settledCount", "unpaidCount", "documents"],
        "properties": {
          "queryId": { "type": "string" },
          "payer": { "type": "string" },
          "documentCount": { "type": "integer" },
          "settledCount": { "type": "integer" },
          "unpaidCount": { "type": "integer" },
          "totalPriceKrw": { "type": "integer" },
          "settledPriceKrw": { "type": "integer" },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["handle", "priceKrw", "status"],
              "properties": {
                "handle": { "type": "string" },
                "priceKrw": { "type": "integer" },
                "status": { "type": "string", "enum": ["unpaid", "quoted", "settled"] },
                "quoteId": { "type": ["string", "null"] },
                "quoteExpiresAt": { "type": ["integer", "null"] },
                "transactionSignature": { "type": ["string", "null"] },
                "network": { "type": ["string", "null"] },
                "settledAt": { "type": ["integer", "null"] }
              }
            }
          }
        }
      },
      "RecoveredPaidDocument": {
        "type": "object",
        "required": ["citation", "settlement"],
        "properties": {
          "citation": { "type": "object" },
          "settlement": { "type": "object" }
        }
      },
      "SynthesizePaidAnswerRequest": {
        "type": "object",
        "required": ["queryId", "handles"],
        "properties": {
          "queryId": { "type": "string" },
          "handles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      },
      "EvidenceSynthesis": {
        "type": "object",
        "required": ["answer", "confidence", "usedHandles", "contributions", "mode"],
        "properties": {
          "answer": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "consensus": { "type": "array", "items": { "type": "string" } },
          "disagreements": { "type": "array", "items": { "type": "string" } },
          "usedHandles": { "type": "array", "items": { "type": "string" } },
          "contributions": { "type": "array", "items": { "type": "object" } },
          "model": { "type": "string" },
          "mode": { "type": "string" }
        }
      },
      "SubmitFeedback": {
        "type": "object",
        "required": ["outcome"],
        "properties": {
          "outcome": { "type": "string", "enum": ["helpful", "not_helpful", "report"] },
          "reason": { "type": ["string", "null"], "maxLength": 1000 }
        }
      },
      "DocumentFeedback": {
        "type": "object",
        "required": ["id", "queryId", "documentHandle", "payer", "outcome", "status", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "queryId": { "type": "string" },
          "documentHandle": { "type": "string" },
          "payer": { "type": "string" },
          "outcome": { "type": "string" },
          "reason": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["recorded", "pending", "upheld", "dismissed"] },
          "reviewNote": { "type": ["string", "null"] },
          "createdAt": { "type": "integer" },
          "reviewedAt": { "type": ["integer", "null"] }
        }
      },
      "WalletChallenge": {
        "type": "object",
        "required": ["id", "wallet", "message", "expiresAt"],
        "properties": {
          "id": { "type": "string" },
          "wallet": { "type": "string" },
          "message": { "type": "string" },
          "expiresAt": { "type": "integer" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
