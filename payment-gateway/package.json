    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "@x402/core": "^2.20.0",
    "@x402/express": "^2.20.0",
    "@x402/fetch": "^2.20.0",
    "@x402/svm": "^2.20.0",
    "express": "^5.2.1",
    "mppx": "^0.5.17"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
