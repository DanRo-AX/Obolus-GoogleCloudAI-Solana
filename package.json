{
  "name": "frames-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stack": "bash scripts/dev-stack.sh",
    "demo:mock": "node scripts/mock-backend.mjs",
    "demo:record": "node scripts/record-e2e.mjs",
    "demo:record:hq": "HQ=1 node scripts/record-e2e.mjs",
    "pay:gateway:sandbox": "OPENSHELF_BACKEND_URL=${OPENSHELF_BACKEND_URL:-http://127.0.0.1:8787} npx --yes @solana/pay@1.0.26 --sandbox gate api backend/paywall.yml --bind 127.0.0.1:${OPENSHELF_PAY_SANDBOX_PORT:-3402} --openapi openapi.json --no-register",
    "pay:smoke": "node scripts/pay-sh-smoke.ts",
    "pay:sandbox:e2e": "bash scripts/pay-sh-sandbox-e2e.sh success",
    "pay:sandbox:e2e:missing-ata": "bash scripts/pay-sh-sandbox-e2e.sh missing-recipient-ata",
    "pay:sandbox:e2e:crash-after-prepare": "bash scripts/pay-sh-sandbox-e2e.sh crash-after-prepare",
    "pay:sandbox:e2e:crash-after-collection": "bash scripts/pay-sh-sandbox-e2e.sh crash-after-collection",
    "pay:sandbox:e2e:cross-route": "bash scripts/pay-sh-sandbox-e2e.sh cross-route-replay",
    "pay:image:gcloud": "docker build -f pay/Dockerfile -t openshelf-pay:gcp-kms .",
    "pay:version": "npx --yes @solana/pay@1.0.26 --version",
    "agent:test": "node --test integrations/antigravity/openshelf/runtime/*.test.mjs",
    "local-agent:test": "node --test apps/obulus-local-agent/test/*.test.mjs",
    "local-agent:doctor": "node apps/obulus-local-agent/src/cli.mjs doctor",
    "local-agent:tools": "node apps/obulus-local-agent/src/cli.mjs tools",
    "local-agent:mcp": "node apps/obulus-local-agent/src/cli.mjs mcp",
    "local-agent:approve": "node apps/obulus-local-agent/src/cli.mjs approve",
    "test:finalist-evidence": "node --test scripts/finalist-evidence.test.mjs",
    "finalist:verify-infra": "node scripts/verify-finalist-infra.mjs",
    "finalist:guard-promotion": "node scripts/guard-cloud-run-promotion.mjs",
    "finalist:record-autonomy": "node scripts/record-finalist-autonomy-evidence.mjs",
    "finalist:record-devnet": "node scripts/record-finalist-devnet-evidence.mjs",
    "finalist:hosted-devnet": "node scripts/hosted-devnet-finalist-e2e.mjs",
    "pitch:verify": "node scripts/verify-pitch-readiness.mjs",
    "pitch:verify-live": "node scripts/verify-pitch-readiness.mjs --require-live",
    "test:unit": "node --test src/lib/*.test.ts",
    "test:pages": "node --test cloudflare/*.test.mjs",
    "typecheck:pages": "wrangler types --check && tsc -p tsconfig.functions.json",
    "build:pages": "VITE_API_BASE= VITE_X402_GATEWAY_BASE=/x402 npm run build",
    "verify:pages-bundle": "node scripts/verify-pages-bundle.mjs",
    "pages:dev": "npm run build:pages && wrangler pages dev dist",
    "pages:deploy": "npm run build:pages && wrangler pages deploy dist --project-name=obolus",
    "agent:doctor": "node integrations/antigravity/openshelf/runtime/server.mjs doctor",
    "agent:tools": "node integrations/antigravity/openshelf/runtime/server.mjs tools",
    "agent:call": "node integrations/antigravity/openshelf/runtime/server.mjs call",
    "orchestrator:dev": "npm --prefix agent-orchestrator run dev",
    "orchestrator:test": "npm --prefix agent-orchestrator run test",
    "x402:devnet:smoke": "node scripts/devnet-x402-smoke.ts",
    "build:web": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "build": "tsc -b && vite build && node scripts/stage-pitch-deck.mjs",
    "lint": "oxlint",
    "check:all": "npm run build && npm run verify:pages-bundle && npm run typecheck:pages && npm run lint && npm run test:unit && npm run test:pages && npm run agent:test && npm run local-agent:test && npm run test:finalist-evidence && npm --prefix payment-gateway run typecheck && npm --prefix payment-gateway run test && npm --prefix agent-orchestrator run typecheck && npm --prefix agent-orchestrator run test && cargo test --manifest-path backend/Cargo.toml && cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "@types/three": "^0.185.3",
    "@x402/core": "^2.20.0",
    "@x402/fetch": "^2.20.0",
    "@x402/svm": "^2.20.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.0",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "jayson": {
      "uuid": "11.1.1"
    }
  }
}
