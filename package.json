{
  "name": "frames-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stack": "bash scripts/dev-stack.sh",
    "pay:gateway:sandbox": "npx --yes @solana/pay --sandbox gate api backend/paywall.yml --bind 127.0.0.1:3402 --no-register",
    "pay:version": "npx --yes @solana/pay --version",
    "x402:devnet:smoke": "npx --yes tsx@4.21.0 scripts/devnet-x402-smoke.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:all": "npm run build && npm run lint && npm --prefix payment-gateway run typecheck && npm --prefix payment-gateway run test && cargo test --manifest-path backend/Cargo.toml && cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "@x402/core": "^2.20.0",
    "@x402/fetch": "^2.20.0",
    "@x402/svm": "^2.20.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.0"
  }
}
