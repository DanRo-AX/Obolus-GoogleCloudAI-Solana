# Copy this file to .env. This must be a real Devnet wallet that can receive USDC.
OPENSHELF_DEFAULT_RECEIVER=YOUR_SOLANA_DEVNET_WALLET_ADDRESS
# One-time research deposits and funded open-call escrow land in the bounded
# KMS service wallet. This must equal OPENSHELF_PAY_GCP_KMS_PUBKEY. Fund it
# with a small amount of Devnet SOL for Pay.sh and refund transaction fees.
OPENSHELF_BUNDLE_RECEIVER=YOUR_KMS_SOLANA_PUBLIC_KEY

# Use the same secret for the Rust API and payment gateway. Replace before deployment.
# production/prod/staging/stage are all managed modes. Unknown environment names,
# malformed booleans, and malformed numeric values fail startup.
OPENSHELF_ENV=development
OPENSHELF_INTERNAL_TOKEN=change-this-to-a-random-32-byte-secret
OPENSHELF_BIND=127.0.0.1:8787
OPENSHELF_DATABASE=backend/openshelf.db
# Required in every managed environment. Use a dedicated retained GCS bucket
# outside the Cloud SQL rollback failure domain for payment and externally
# billed model-call intents. Provisioning and IAM require a prior data-access
# registry entry; never use a service-account key.
OPENSHELF_ROLLBACK_AUDIT_BUCKET=
# Required when sharing ax-apps-storage. No leading or trailing slash.
OPENSHELF_ROLLBACK_AUDIT_PREFIX=obolus/rollback-audit
# Operator-only restore commands also require a unique incident/restore ID.
# Do not set either acknowledgement on a serving revision. The sweep installs
# a durable database hold before reading GCS; resolution requires a separate,
# explicit external-receipt evidence reference.
# OPENSHELF_RESTORE_ID=cloud-sql-restore-YYYYMMDD-incident-id
# OPENSHELF_RESTORE_SWEEP_ACK=payments-stopped-and-drained
# OPENSHELF_RESTORE_RESOLVE_ACK=payments-stopped-and-external-receipts-reconciled
# OPENSHELF_RESTORE_RESOLUTION_EVIDENCE=incident://TICKET/receipt-report
# Managed modes require an explicit PostgreSQL connection string; they reject
# SQLite paths and the production container has no embedded /data fallback.
# Synthetic personas and calls exist only for explicit UI/test fixtures. Keep
# this false for normal local and managed use so the searchable store contains
# real contributor records plus provenance-bound public evidence only.
OPENSHELF_SEED_DEMO=false
OPENSHELF_FRONTEND_ORIGIN=http://localhost:4319
# Exact public API origin embedded in one-time Pay SIWX wallet-link requests.
# Loopback HTTP is allowed for development; remote origins must use HTTPS.
OPENSHELF_AGENT_API_ORIGIN=http://127.0.0.1:8787
OPENSHELF_SECURE_COOKIES=false
# Set true only with explicit mainnet network/mint configuration.
OPENSHELF_REQUIRE_MAINNET=false
OPENSHELF_X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
OPENSHELF_X402_ASSET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
OPENSHELF_KRW_PER_USDC=1350
# 30 seconds through 24 hours. Suffixes such as `300000ms` are invalid.
OPENSHELF_QUOTE_TTL_MS=300000
# Never enable this on a public deployment. It bypasses x402 for local demos.
OPENSHELF_ALLOW_DEMO_OPEN=false
# Temporary cutover-only switch; keep false after Pay.sh v1 metering is removed.
OPENSHELF_ACCEPT_LEGACY_PAY_SH_CALLBACKS=false

# Official Pay.sh Cloud Run gateway. The internal token is shared with Rust;
# RPC URLs belong in Secret Manager. Pay.sh uses a GCP KMS Solana signer.
OPENSHELF_BACKEND_URL=https://YOUR_BACKEND_SERVICE.run.app
OPENSHELF_PAY_OPERATOR_WALLET=YOUR_SOLANA_DEVNET_OPERATOR_WALLET
OPENSHELF_PAY_RPC_URL=https://YOUR_MANAGED_SOLANA_DEVNET_RPC
# A provider independent from the primary endpoint is required for automatic
# release after absence. A single origin may recover settlement but cannot
# authorize another charge.
OPENSHELF_PAY_RECONCILIATION_RPC_URLS=https://YOUR_SECOND_INDEPENDENT_SOLANA_DEVNET_RPC
OPENSHELF_PAY_GCP_KMS_KEY_NAME=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY/cryptoKeyVersions/1
OPENSHELF_PAY_GCP_KMS_PUBKEY=YOUR_KMS_SOLANA_PUBLIC_KEY
# Shared only by the public application proxy and the official Pay.sh
# container's pre-gate nginx boundary. Use one URL-safe 32+ character secret.
OPENSHELF_PAY_FRONT_TOKEN=change-this-to-an-independent-random-32-byte-secret
# The official gate is never an agent-facing origin. Agents and the
# orchestrator both use the public payment gateway below.
PAY_SH_PRIVATE_URL=https://YOUR_PRIVATE_PAY_SH_SERVICE.run.app
# Server-side Pay.sh worker. It receives only an internal job id; browser wallet
# keys and delegate permissions are never sent here.
PAY_SH_GATEWAY_BASE=https://YOUR_X402_GATEWAY_SERVICE.run.app
RESEARCH_ORCHESTRATOR_URL=https://YOUR_ORCHESTRATOR_SERVICE.run.app
# Local direct-Pay.sh sandbox drills may set this false. Managed runtimes reject
# the override, and bundle routes still require the orchestrator independently.
OPENSHELF_REQUIRE_RESEARCH_ORCHESTRATOR=true
OPENSHELF_RESEARCH_POLL_MS=10000
# Reconciliation intervals are 5,000–300,000 ms, batch sizes 1–100, and
# signature pages 1–20. Bounds also prevent Node's >2^31-1 timer hot loop.
OPENSHELF_PAY_RECONCILIATION_INTERVAL_MS=30000
OPENSHELF_PAY_RECONCILIATION_BATCH_SIZE=25
OPENSHELF_PAY_RECONCILIATION_SIGNATURE_PAGES=5
OPENSHELF_REFUND_WORKER_ID=openshelf-kms-payout-1

# Gemini runs through Vertex AI only. Authentication uses Application Default
# Credentials: `gcloud auth application-default login` locally, and an attached
# service account / Workload Identity in production. Never paste an access token
# or service-account private key into this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
OPENSHELF_VERTEX_MODEL=gemini-2.5-flash
# 1 minute through 24 hours; malformed/zero values fail startup rather than
# causing a repeated Vertex request loop or an effectively immortal baseline.
OPENSHELF_AI_BASELINE_TTL_MS=21600000

# Wallet-only is the shipped account model. Keep this false until the deferred
# email/password recovery work has a reviewed provider, sender domain, abuse
# controls, and end-to-end recovery test. Managed startup requires all three
# provider values below only when this switch is true.
OPENSHELF_EMAIL_PASSWORD_AUTH_ENABLED=false
# Optional durable email delivery. The endpoint accepts a Resend-compatible JSON body:
# { from, to: [email], subject, text } with bearer authentication.
OPENSHELF_EMAIL_ENDPOINT=
OPENSHELF_EMAIL_API_KEY=
OPENSHELF_EMAIL_FROM=

RUST_API_URL=http://127.0.0.1:8787
NODE_ENV=development
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Optional managed RPC endpoint. Browser reads go through the gateway's restricted
# proxy, so credentials stay server-side. The public Devnet RPC is the fallback.
X402_RPC_URL=
# A second-provider origin is mandatory in managed environments. Exact landed
# transactions and finalized absence must agree across every configured origin.
X402_RECONCILIATION_RPC_URLS=https://YOUR_SECOND_INDEPENDENT_SOLANA_DEVNET_RPC
# Pay.sh may use a different network from x402 in sandbox and rolling tests.
# Production should point this to the managed RPC for the Pay.sh quote network.
PAY_SH_RPC_URL=
# The public proxy buffers Pay.sh bodies until this independent provider and
# PAY_SH_RPC_URL both reproduce the exact receipt transaction as finalized.
PAY_SH_RECONCILIATION_RPC_URLS=https://YOUR_SECOND_INDEPENDENT_SOLANA_DEVNET_RPC
# Per-process safety net; production still needs an edge/distributed rate limit.
X402_RPC_RATE_LIMIT_PER_MINUTE=120
# Finalized-chain recovery starts after the durable fence's one-minute deadline.
# Interval/batch/page bounds match the Pay.sh worker bounds documented above.
X402_CHAIN_RECONCILIATION_INTERVAL_MS=30000
X402_CHAIN_RECONCILIATION_BATCH_SIZE=25
X402_CHAIN_RECONCILIATION_SIGNATURE_PAGES=5
# The paid body remains buffered until both independent RPCs reproduce the
# facilitator-declared exact finalized transaction. Timeout keeps the durable
# fence and returns a recoverable failure; it never retries settlement.
X402_SETTLEMENT_FINALITY_TIMEOUT_MS=20000
X402_SETTLEMENT_FINALITY_POLL_INTERVAL_MS=500
# Immediate finality checks do not use the slower background retry client.
X402_SETTLEMENT_FINALITY_RPC_TIMEOUT_MS=3000
# The one facilitator settlement POST has its own cancellable transport bound.
# A timeout is ambiguous: keep the attempt and let finalized-chain recovery decide.
X402_FACILITATOR_SETTLEMENT_TIMEOUT_MS=15000
PORT=1402
FRONTEND_ORIGIN=http://localhost:4319

# Antigravity plugin endpoints and optional per-user local state/account choice.
OPENSHELF_API_URL=http://127.0.0.1:8787
OPENSHELF_GATEWAY_URL=http://127.0.0.1:1402
# OPENSHELF_AGENT_PROFILE=buyer
# OPENSHELF_AGENT_STATE=/absolute/path/to/agent-session.json
# OPENSHELF_PAY_ACCOUNT=buyer

# Keeps the local Vite proxy pinned to the local Rust API. Without this, the
# Cloud Run placeholder in OPENSHELF_BACKEND_URL above hijacks /api and every
# question fails with "Backend returned 502".
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

VITE_BACKEND_ENABLED=true
VITE_X402_ENABLED=true
VITE_X402_GATEWAY_BASE=http://127.0.0.1:1402
# Refill size requested only when the verified wallet's prepaid balance is low.
# Must be an exact 0.1–1000 decimal with at most six places; it is never clamped.
VITE_PREPAID_TOPUP_USDC=5
# Production must remain 1350 to match Rust and Pay.sh.
VITE_KRW_PER_USDC=1350
