# Copy this file to .env. This must be a real Devnet wallet that can receive USDC.
OPENSHELF_DEFAULT_RECEIVER=YOUR_SOLANA_DEVNET_WALLET_ADDRESS
# One-time research deposits and funded open-call escrow land in the bounded
# KMS service wallet. This must equal OPENSHELF_PAY_GCP_KMS_PUBKEY. Fund it
# with a small amount of Devnet SOL for Pay.sh and refund transaction fees.
OPENSHELF_BUNDLE_RECEIVER=YOUR_KMS_SOLANA_PUBLIC_KEY

# Use the same secret for the Rust API and payment gateway. Replace before deployment.
OPENSHELF_ENV=development
OPENSHELF_INTERNAL_TOKEN=change-this-to-a-random-32-byte-secret
OPENSHELF_BIND=127.0.0.1:8787
OPENSHELF_DATABASE=backend/openshelf.db
# Demo personas and calls are seeded by default only outside production.
OPENSHELF_SEED_DEMO=true
OPENSHELF_FRONTEND_ORIGIN=http://localhost:4319
# Exact public API origin embedded in one-time Pay SIWX wallet-link requests.
# Loopback HTTP is allowed for development; remote origins must use HTTPS.
OPENSHELF_AGENT_API_ORIGIN=http://127.0.0.1:8787
OPENSHELF_SECURE_COOKIES=false
# Set true only with explicit mainnet network/mint configuration.
OPENSHELF_REQUIRE_MAINNET=false
OPENSHELF_X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
OPENSHELF_X402_ASSET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
OPENSHELF_KRW_PER_USDC=1350
OPENSHELF_QUOTE_TTL_MS=300000
# Never enable this on a public deployment. It bypasses x402 for local demos.
OPENSHELF_ALLOW_DEMO_OPEN=false

# Official Pay.sh Cloud Run gateway. The internal token is shared with Rust;
# RPC URLs belong in Secret Manager. Pay.sh uses a GCP KMS Solana signer.
OPENSHELF_BACKEND_URL=https://YOUR_BACKEND_SERVICE.run.app
OPENSHELF_PAY_OPERATOR_WALLET=YOUR_SOLANA_DEVNET_OPERATOR_WALLET
OPENSHELF_PAY_RPC_URL=https://YOUR_MANAGED_SOLANA_DEVNET_RPC
OPENSHELF_PAY_GCP_KMS_KEY_NAME=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY/cryptoKeyVersions/1
OPENSHELF_PAY_GCP_KMS_PUBKEY=YOUR_KMS_SOLANA_PUBLIC_KEY
# Server-side Pay.sh worker. It receives only an internal job id; browser wallet
# keys and delegate permissions are never sent here.
PAY_SH_GATEWAY_BASE=https://YOUR_PAY_SH_SERVICE.run.app
RESEARCH_ORCHESTRATOR_URL=https://YOUR_ORCHESTRATOR_SERVICE.run.app
OPENSHELF_RESEARCH_POLL_MS=10000
OPENSHELF_REFUND_WORKER_ID=openshelf-kms-payout-1

# Gemini runs through Vertex AI only. Authentication uses Application Default
# Credentials: `gcloud auth application-default login` locally, and an attached
# service account / Workload Identity in production. Never paste an access token
# or service-account private key into this file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
OPENSHELF_VERTEX_MODEL=gemini-2.5-flash
OPENSHELF_AI_BASELINE_TTL_MS=21600000

# Optional contributor email alerts. The endpoint accepts a Resend-compatible
# JSON body: { from, to: [email], subject, text } with bearer authentication.
OPENSHELF_EMAIL_ENDPOINT=
OPENSHELF_EMAIL_API_KEY=
OPENSHELF_EMAIL_FROM=

RUST_API_URL=http://127.0.0.1:8787
NODE_ENV=development
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Optional managed RPC endpoint. Browser reads go through the gateway's restricted
# proxy, so credentials stay server-side. The public Devnet RPC is the fallback.
X402_RPC_URL=
# Per-process safety net; production still needs an edge/distributed rate limit.
X402_RPC_RATE_LIMIT_PER_MINUTE=120
X402_OUTBOX_PATH=payment-gateway/x402-outbox.ndjson
PORT=1402
FRONTEND_ORIGIN=http://localhost:4319

# Antigravity plugin endpoints and optional per-user local state/account choice.
OPENSHELF_API_URL=http://127.0.0.1:8787
OPENSHELF_GATEWAY_URL=http://127.0.0.1:1402
# OPENSHELF_AGENT_PROFILE=buyer
# OPENSHELF_AGENT_STATE=/absolute/path/to/agent-session.json
# OPENSHELF_PAY_ACCOUNT=buyer

VITE_BACKEND_ENABLED=true
VITE_X402_ENABLED=true
VITE_X402_GATEWAY_BASE=http://127.0.0.1:1402
# Refill size requested only when the verified wallet's prepaid balance is low.
VITE_PREPAID_TOPUP_USDC=5
VITE_KRW_PER_USDC=1350
