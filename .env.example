# Copy this file to .env. This must be a real Devnet wallet that can receive USDC.
OPENSHELF_DEFAULT_RECEIVER=YOUR_SOLANA_DEVNET_WALLET_ADDRESS

# Use the same secret for the Rust API and payment gateway. Replace before deployment.
OPENSHELF_INTERNAL_TOKEN=change-this-before-deploy
OPENSHELF_BIND=127.0.0.1:8787
OPENSHELF_DATABASE=backend/openshelf.db
OPENSHELF_X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
OPENSHELF_X402_ASSET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
OPENSHELF_KRW_PER_USDC=1350
OPENSHELF_QUOTE_TTL_MS=300000
# Never enable this on a public deployment. It bypasses x402 for local demos.
OPENSHELF_ALLOW_DEMO_OPEN=false
# Enable whenever the browser reaches the API through HTTPS.
OPENSHELF_SECURE_COOKIES=false

# Gemini evidence synthesis. Use Vertex AI in production; the API-key path is
# a local fallback. If neither is configured, paid passages are returned with
# an explicit evidence-only notice and no fabricated synthesis.
OPENSHELF_GEMINI_MODEL=gemini-2.5-flash
OPENSHELF_VERTEX_ENDPOINT=
OPENSHELF_GOOGLE_ACCESS_TOKEN=
GEMINI_API_KEY=

RUST_API_URL=http://127.0.0.1:8787
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Optional paid RPC endpoint. The public Devnet RPC is used when this is blank.
X402_RPC_URL=
X402_OUTBOX_PATH=payment-gateway/x402-outbox.ndjson
PORT=1402
FRONTEND_ORIGIN=http://localhost:4319

VITE_BACKEND_ENABLED=true
VITE_X402_ENABLED=true
VITE_X402_GATEWAY_BASE=http://127.0.0.1:1402
