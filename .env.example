# Copy this file to .env. This must be a real Devnet wallet that can receive USDC.
OPENSHELF_DEFAULT_RECEIVER=YOUR_SOLANA_DEVNET_WALLET_ADDRESS
# Aggregate payments for 2–100 documents land here once. Rust snapshots each
# contributor beneficiary and records a claimable share for later payout.
OPENSHELF_BUNDLE_RECEIVER=YOUR_SOLANA_DEVNET_ESCROW_WALLET_ADDRESS

# Use the same secret for the Rust API and payment gateway. Replace before deployment.
OPENSHELF_ENV=development
OPENSHELF_INTERNAL_TOKEN=change-this-before-deploy
OPENSHELF_BIND=127.0.0.1:8787
OPENSHELF_DATABASE=backend/openshelf.db
# Demo personas and calls are seeded by default only outside production.
OPENSHELF_SEED_DEMO=true
OPENSHELF_FRONTEND_ORIGIN=http://localhost:4319
OPENSHELF_SECURE_COOKIES=false
# Set true only with explicit mainnet network/mint configuration.
OPENSHELF_REQUIRE_MAINNET=false
OPENSHELF_X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
OPENSHELF_X402_ASSET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
OPENSHELF_KRW_PER_USDC=1350
OPENSHELF_QUOTE_TTL_MS=300000
# Never enable this on a public deployment. It bypasses x402 for local demos.
OPENSHELF_ALLOW_DEMO_OPEN=false

# Evidence synthesis. Vertex AI is preferred for deployed environments. If no
# provider is configured, the API returns paid passages with an explicit
# evidence-only notice and does not invent a synthesis.
OPENSHELF_GEMINI_MODEL=gemini-2.5-flash
OPENSHELF_AI_BASELINE_TTL_MS=21600000
OPENSHELF_VERTEX_ENDPOINT=
OPENSHELF_GOOGLE_ACCESS_TOKEN=

# Optional contributor email alerts. The endpoint accepts a Resend-compatible
# JSON body: { from, to: [email], subject, text } with bearer authentication.
OPENSHELF_EMAIL_ENDPOINT=
OPENSHELF_EMAIL_API_KEY=
OPENSHELF_EMAIL_FROM=
GEMINI_API_KEY=

RUST_API_URL=http://127.0.0.1:8787
NODE_ENV=development
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Optional managed RPC endpoint. Browser reads go through the gateway's restricted
# proxy, so credentials stay server-side. The public Devnet RPC is the fallback.
X402_RPC_URL=
# Per-process safety net; production still needs an edge/distributed rate limit.
X402_RPC_RATE_LIMIT_PER_MINUTE=120
X402_OUTBOX_PATH=payment-gateway/x402-outbox.ndjson
PORT=1402
FRONTEND_ORIGIN=http://localhost:4319

VITE_BACKEND_ENABLED=true
VITE_X402_ENABLED=true
VITE_X402_GATEWAY_BASE=http://127.0.0.1:1402
VITE_KRW_PER_USDC=1350
