{
  "name": "@obulus/desktop",
  "private": true,
  "version": "0.2.0",
  "description": "Local-custody Obulus buyer, contributor, agent and MCP application",
  "author": "Obulus",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "npm run stage:assets && electron .",
    "stage:assets": "node scripts/stage-assets.mjs",
    "stage:pay": "node scripts/stage-pay.mjs",
    "test": "node --test test/*.test.mjs",
    "dist:mac": "npm run stage:assets && npm run stage:pay && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "@obulus/local-agent": "file:../obulus-local-agent"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "network.obulus.desktop",
    "productName": "Obulus",
    "asar": true,
    "files": [
      "src/**/*",
      "build/fonts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/pay",
        "to": "pay/pay"
      },
      {
        "from": "build/pay.sha256",
        "to": "pay/pay.sha256"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "signIgnore": "Contents/Resources/pay/pay$",
      "target": ["dmg", "zip"]
    }
  }
}
